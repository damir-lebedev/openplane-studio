{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPlane Studio",
  "version": "0.1.0",
  "identifier": "com.openplane.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPlane Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0b1118"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/wdi-simple.exe",
      "resources/LICENSE-libwdi.txt",
      "resources/offline/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "template": "installer/installer.nsi",
        "compression": "none"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "publisher": "OpenPlane",
    "category": "Utility",
    "shortDescription": "OpenPlane Studio",
    "longDescription": "Настройка, сборка и прошивка полётного контроллера OpenPlane"
  }
}
